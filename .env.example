# Copy to `.env` (git-ignored) and fill in real values before
# `docker compose up --build`. Every default in docker-compose.yml is a
# working local value, not a production one — set real passwords before
# this stack is ever reachable from outside localhost.

# --- Postgres (one instance, two logical databases: phrase_drill, keycloak) ---
POSTGRES_USER=phrase_drill
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phrase_drill

# --- Keycloak admin console (http://localhost:8081) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Real origin the browser redirects back to after login. Must NOT be a
# wildcard like https://*/* (open-redirect surface) — one concrete origin
# plus a trailing /* path wildcard.
APP_REDIRECT_URI=http://localhost:8080/*

# --- What the app server uses to verify tokens (must agree with the realm above) ---
# KEYCLOAK_ISSUER is the literal `iss` string Keycloak puts in every token —
# it must be exactly what the browser used to reach Keycloak.
KEYCLOAK_ISSUER=http://localhost:8081/realms/phrase-drill
# KEYCLOAK_JWKS_URI is only a network address for fetching signing keys —
# it can use Docker's internal DNS even though KEYCLOAK_ISSUER can't.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/phrase-drill/protocol/openid-connect/certs
TOKEN_AUDIENCE=phrase-drill-app

# --- What the built PWA is told at build time (public, no secret) ---
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=phrase-drill
VITE_KEYCLOAK_CLIENT_ID=phrase-drill-app

# --- Provider keys (server-side only, never sent to the browser) ---
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
