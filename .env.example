# Copy to `.env` (git-ignored) and fill in real values before
# `docker compose up --build`. Every default in docker-compose.yml is a
# working local value, not a production one — set a real Postgres password
# before this stack is ever reachable from outside localhost.

# --- Postgres ---
POSTGRES_USER=phrase_drill
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phrase_drill

# --- Provider keys (server-side only, never sent to the browser) ---
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# --- Supabase (server-side only) ---
# SUPABASE_URL: the project's API URL. SUPABASE_SECRET_KEY: the secret
# (service) key — it bypasses row security, so it never leaves the server and
# never goes in the browser bundle. Locally: `npx supabase status -o env`
# prints API_URL and SECRET_KEY. The server refuses to boot without both.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Device login (Supabase Auth) ---
# Read at build time by Vite (`npm run build`, `npm run dev`) and baked into
# the bundle; the build fails if either is unset. Both are public by design.
# Local stack: `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
